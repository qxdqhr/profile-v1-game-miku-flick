; Miku Flick — Godot minimal dual-track. Portrait.

config_version=5

[application]

config/name="Miku Flick"
config/description="Minimal kana+flick rhythm game. Dual-track with /testField/mikuFlick."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[autoload]

Sa2kitCjk="*res://addons/sa2kit_godot/autoload/cjk_boot.gd"

[gui]

theme/custom_font="res://addons/sa2kit_godot/fonts/SourceHanSansCN-Regular.otf"

[editor_plugins]

enabled=PackedStringArray("res://addons/sa2kit_godot/plugin.cfg")
